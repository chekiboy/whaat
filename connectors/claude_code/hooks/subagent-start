#!/usr/bin/env python3
"""SubagentStart hook: a subagent gets the identity's global index, `reach: every-agent` core files and memory map as
additionalContext.

SessionStart output never reaches a subagent; a teammate is a session of its own and runs SessionStart itself, so this
event is the subagent's only one. Each hook's additionalContext is capped at 10,000 characters, so the text is split
on line ends across several hook commands (part N of M), as session-start splits an index. Without a token or a
server it prints nothing.

    subagent-start N/M
"""

from __future__ import annotations

import json
import sys

import whaat_hook

CAP = 9500


def parts(text: str, size: int) -> list[str]:
    chunks, current = [], ""
    for line in text.splitlines(keepends=True):
        if current and len(current) + len(line) > size:
            chunks.append(current)
            current = ""
        current += line
    return [*chunks, current] if current else chunks


def main():
    try:
        part, total = (int(n) for n in sys.argv[1].split("/"))
    except (IndexError, ValueError):
        return
    core = whaat_hook.call("/api/v1/memory/recall/subagent-core")
    text = core and core.get("text")
    if not text:
        return
    chunks = parts(text, CAP - 200)
    if part > len(chunks) or part > total:
        return
    chunk = chunks[part - 1]
    if part == total and len(chunks) > total:
        chunk += "\n[memory] the rest does not fit the hooks: run memory-recall index task=\"<what you are doing>\"\n"
    head = f"[memory] for this subagent, part {part}/{min(len(chunks), total)}:\n"
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "SubagentStart", "additionalContext": head + chunk}},
                     ensure_ascii=False))


if __name__ == "__main__":
    main()
